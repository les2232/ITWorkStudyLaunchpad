# GENERIC NON-VM REFERENCE ONLY; not an approved deployment or a VM install file.
# Current target: future lesliec cutover using deploy/vm/launchpad.env.example
# and the mandatory Unix-socket systemd unit. Preserve itsupport unless retired.
# The app never loads this example automatically. Do not populate secrets here.
LAUNCHPAD_REAL_MODE=1
LAUNCHPAD_DEMO_MODE=0
LAUNCHPAD_PILOT_MODE=0
LAUNCHPAD_AUTH_BACKEND=ad
# Production background-check policy. The isolated test has a separate launcher.
LAUNCHPAD_AD_SESSION_POLICY=revalidate

# Generic path examples only. Each store must be separately initialized on
# approved durable storage. The selected VM uses /var/lib/launchpad instead.
LAUNCHPAD_DATA_DIR=/var/lib/launchpad-staging
LAUNCHPAD_DB_PATH=/var/lib/launchpad-staging/learners.sqlite
LAUNCHPAD_AD_STATE_PATH=/var/lib/launchpad-staging/ad-security.sqlite
LAUNCHPAD_TRUSTED_HOSTS=lesliec.ccaurora.edu

# Owner-approved host/domain/search base required; no guessed defaults.
LAUNCHPAD_AD_HOST=
LAUNCHPAD_AD_PORT=636
LAUNCHPAD_AD_DOMAIN=
LAUNCHPAD_AD_BASE_DN=
# User verified existence, exact DN and own membership in ADUC on 2026-10-08.
# Launchpad eligibility approval, membership policy and live AD remain pending.
LAUNCHPAD_AD_GROUP_DN=CN=CCA_Leslie_Project,OU=CCA_Groups_Security_User,OU=CCA,DC=ccc,DC=ccofc,DC=edu
# Choose direct or nested only after the group owner approves the policy.
LAUNCHPAD_AD_GROUP_POLICY=
LAUNCHPAD_AD_IDENTITY_NAMESPACE=
LAUNCHPAD_AD_CA_FILE=/etc/ssl/certs/launchpad-ad-ca.pem

# Lookup option selected for preparation; CCA availability/permissions unknown.
# Minimum read/search scope and outage handling: docs/ad_authentication.md.
# Proposed 60-second interval is configurable 1..300, not owner-approved policy.
LAUNCHPAD_AD_REVALIDATE_SECONDS=60
LAUNCHPAD_AD_LOOKUP_USERNAME=
LAUNCHPAD_AD_LOOKUP_PASSWORD=
LAUNCHPAD_SECRET_KEY=

# Empty required settings fail closed. Secrets belong in approved private
# custody, independent of the old assistant. AD needs no OIDC registration.
# NON-VM ONLY: generic TLS ingress can use the host-assigned PORT; never copy
# this TCP setting into the VM configuration, whose unit supplies a Unix socket.
PORT=10000
# No invitation/demo bootstrap, debug flags or automatic role/learner mapping.
# Retention/backup policy is not an invented application environment setting.
