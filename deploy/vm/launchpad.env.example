# REPOSITORY PLACEHOLDER ONLY; never populated with real credentials here.
# Future installation: /etc/launchpad/launchpad.env, root:root mode 0600.
# systemd reads it and passes the environment to the dedicated non-root service.
# No export keywords, shell substitutions, real passwords or shared invitation.
LAUNCHPAD_REAL_MODE=1
LAUNCHPAD_DEMO_MODE=0
LAUNCHPAD_PILOT_MODE=0
LAUNCHPAD_DATA_DIR=/var/lib/launchpad
LAUNCHPAD_DB_PATH=/var/lib/launchpad/learners.sqlite

# FUTURE CUTOVER ONLY: remove lesliec from both old vhost server-name lists
# in the approved window before enabling Launchpad. Preserve itsupport unless
# separately retired. No installed configuration is changed by this example.
LAUNCHPAD_TRUSTED_HOSTS=lesliec.ccaurora.edu
LAUNCHPAD_AUTH_BACKEND=ad
# revalidate: background directory checks; needs the lookup account below.
# signin: password/group checked at every sign-in; no lookup account (leave
# both LOOKUP values empty); sessions end after 30 idle minutes or
# LAUNCHPAD_SESSION_MAX_HOURS (1..8). Never controlled_test here.
# See docs/regular_use_release.md.
LAUNCHPAD_AD_SESSION_POLICY=revalidate
LAUNCHPAD_SESSION_MAX_HOURS=4

# Directory use requires the AD owner's approval. The supplied host
# CCCDC01.ccc.ccofc.edu and domain ccc.ccofc.edu are candidates, not verified
# configuration. Bare DNS host only: no ldap://, ldaps://, embedded port or IP.
LAUNCHPAD_AD_HOST=
LAUNCHPAD_AD_PORT=636
LAUNCHPAD_AD_DOMAIN=
LAUNCHPAD_AD_BASE_DN=
# User verified group existence, this exact DN and own membership in ADUC
# on 2026-10-08. Launchpad eligibility approval remains pending; this is not
# evidence of working LDAPS or permission to enroll the group's members.
LAUNCHPAD_AD_GROUP_DN=CN=CCA_Leslie_Project,OU=CCA_Groups_Security_User,OU=CCA,DC=ccc,DC=ccofc,DC=edu
# Choose exactly direct or nested after the group owner approves semantics.
LAUNCHPAD_AD_GROUP_POLICY=
# A stable, nonzero canonical lowercase UUID chosen/recorded once by the owner.
# Enrollment issuer is urn:launchpad:ad:<namespace UUID>; subject is objectGUID.
# It is not a secret, not a learner GUID, and must survive backup/restore.
LAUNCHPAD_AD_IDENTITY_NAMESPACE=
# Approved public CA bundle at this future path, root-owned 0644. It must be
# readable by launchpad; do not put it inside root-only /etc/launchpad (0700).
# This does not install a CA or alter system-wide trust.
LAUNCHPAD_AD_CA_FILE=/etc/ssl/certs/launchpad-ad-ca.pem

# CANDIDATE POLICY, NOT APPROVED/PROVISIONED: a dedicated read-only lookup UPN
# checks enabled/group eligibility by GUID without retaining learner passwords.
# The owner must approve lookup scope, rotation, outage behavior and interval.
LAUNCHPAD_AD_LOOKUP_USERNAME=
LAUNCHPAD_AD_LOOKUP_PASSWORD=
# Proposed 60 seconds; allowed 1..300. Includes a bounded positive-result cache;
# directory replication and in-flight requests add limits described in the docs.
LAUNCHPAD_AD_REVALIDATE_SECONDS=60
# Separate persistent throttle store, initialized explicitly before startup.
# Missing/corrupt state must fail closed; it is not a learner-record database.
LAUNCHPAD_AD_STATE_PATH=/var/lib/launchpad/ad-security.sqlite
LAUNCHPAD_SECRET_KEY=

# Empty values deliberately prevent startup. Inject a distinct random signing
# secret (32+ characters) and approved lookup secret through private operators.
# Never reuse the assistant's secrets, accounts or database. OIDC values are not
# needed in AD mode; switching backend/enrollment is a separately reviewed change.
# Do not override GUNICORN_CMD_ARGS, PORT, FORWARDED_ALLOW_IPS or debug flags:
# the reviewed systemd unit supplies the protected Unix-socket binding.
# Retention/backup decisions are operational policy, not invented env settings.
